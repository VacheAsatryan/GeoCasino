{
    "compilerOptions": {
        "target": "ES2017",
        "lib": [
            "DOM",
            "ESNext"
        ],
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src",
        "src/**/*.d.ts"
    ]
}